{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "FitRepacks Library",
  "version": "1.0.14",
  "identifier": "com.fitrepacks.library",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FitRepacks Library & Launcher",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Game",
    "shortDescription": "FitRepacks Library & Launcher",
    "longDescription": "Modern library manager and game launcher for FitGirl and SteamRIP repacks with Wine & Proton support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzNDI1QUQ2MENDNTBCOTAKUldTUUM4VU0xbHBDczJxVHYzQ0IvZWxxdHN3ZFE1dVFsVTVRdTI3bmgrSlVObEtjNWYwNDQ5N2UK",
      "endpoints": [
        "https://github.com/alsasoft-web/FitRepacks-Library/releases/latest/download/latest.json"
      ]
    }
  }
}
